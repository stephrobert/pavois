.DS_Store
# CINC/InSpec writes one of these beside every profile it resolves; they are per-run state.
inspec.lock
**/inspec.lock
# No blanket `*.lock`. It used to be here for inspec.lock above, and it also swallowed uv.lock,
# which is the OPPOSITE of state: it is the pinned resolution of the Python tooling, the uv
# equivalent of go.sum and package-lock.json, both of which are committed. Untracked, it meant
# the Trivy audit in deps.yml had no uv lockfile to read on a runner, so the tooling's
# dependencies were the one set in this repository that nothing ever scanned. Its first scan
# reported 17 fixable HIGH/CRITICAL advisories (pyjwt, authlib, cryptography, certifi, anyio,
# dnspython, joserfc). `.venv/` ignores itself, so dropping the pattern exposes nothing else.
*.pyc
__pycache__/
reports/
go/pavois

# per-machine hardening plans (user-edited inputs, not committed)
hardening-plan-*.yml

# restore points captured before an apply (host state, per-machine, never shipped)
restore-points/

# clean-room lab config: real hypervisor IPs, VMIDs, passwords (only the .example ships)
campaign.env
tools/clean_room_fleet
!tools/clean_room_fleet.example

.pavois-vault/
archive/

# Derived artifacts: NOT shipped. Regenerate from docs/reference with `mise run regen`.
# The repo ships only the source of truth (rules.yml + the enriched site content);
# the binary embeds nothing from these, so a from-source build rebuilds them.
docs/reference/pavois-content/
profiles/linux/*/controls/
/oscal/
site/public/oscal/

# unlighthouse perf reports (generated)
site/.unlighthouse/

# Build artifacts (binaries, .deb/.rpm): produced by the release workflow, never committed
dist/

# Embedded corpus is populated at build time (mise run embed:corpus); keep only the .keep.
go/internal/corpus/profiles/*
!go/internal/corpus/profiles/.keep
go/internal/reference/content/*
!go/internal/reference/content/.keep
go/internal/reference/catalogue/*
!go/internal/reference/catalogue/.keep
go/internal/reference/data/*
!go/internal/reference/data/.keep
!go/internal/reference/data/kernel-build/
go/internal/reference/data/kernel-build/*
!go/internal/reference/data/kernel-build/.keep
site/src/data/cli.json

# Personal editor workspaces. They carry one developer's paths and folder layout, which is of no
# use to anyone else and blocks a release preflight on a dirty tree.
*.code-workspace

# tools/validate_prs.sh keeps its step logs here so a failure can be read after the run
.pr-validate-logs/

# vm_bisect.sh output: guest consoles and launch logs, per-run and never worth committing.
bisect/
