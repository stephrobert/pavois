# Derived artifacts — NOT shipped. Regenerate from docs/reference with `mise run regen`.
# The repo ships only the source of truth (rules.yml + the enriched site content);
# the binary embeds nothing from these, so a from-source build rebuilds them.
docs/reference/pavois-content/
profiles/linux/*/controls/
/oscal/
site/public/oscal/

# unlighthouse perf reports (generated)
site/.unlighthouse/

# Build artifacts (binaries, .deb/.rpm) — produced by the release workflow, never committed
dist/
