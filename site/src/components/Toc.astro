---
import type { Heading } from '../lib/markdown';
interface Props {
  headings: Heading[];
  lang: string;
}
const { headings, lang } = Astro.props;
---

{
  headings.length > 0 && (
    <aside class="toc">
      <p class="toc-h">{lang === 'fr' ? 'Sommaire' : 'On this page'}</p>
      <nav>
        <ul>
          {headings.map((h) => (
            <li class={`toc-d${h.depth}`}>
              <a href={`#${h.slug}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    </aside>
  )
}
