  "severity": "medium",
  "domain": "Accounts (login.defs)",
  "evidence_type": "persistent-config",
  "reboot_survivable": "yes",
  "norms": {},
  "check": [
    "describe login_defs do",
    "  its('SHA_CRYPT_MIN_ROUNDS') { should cmp >= 10000 }",
    "end"
  ],
  "remediation": {
    "file": "/etc/login.defs",
    "key": "SHA_CRYPT_MIN_ROUNDS",
    "resource": "conf_line",
    "sep": "space",
    "value": "65536"
  },
  "title": {
    "en": "Set SHA_CRYPT minimum rounds in login.defs",
    "fr": "Set SHA_CRYPT minimum rounds in login.defs"
  },
