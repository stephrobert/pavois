{
  "id": "sudo-custom-logfile",
  "supported_os": [
    "debian12",
    "debian13",
    "fedora",
    "rhel10",
    "rhel8",
    "rhel9",
    "ubuntu2404",
    "ubuntu2604"
  ],
  "os_versions": {
    "debian12": "1.1.0",
    "debian13": "1.0.0",
    "rhel10": "1.0.0",
    "rhel8": "4.0.0",
    "rhel9": "2.0.0",
    "ubuntu2404": "1.0.0"
  },
  "severity": "low",
  "domain": "Sudo",
  "evidence_type": "persistent-config",
  "reboot_survivable": "yes",
  "norms": {
    "cis": "5.2.3",
    "pci-dss": "2.2.6"
  },
  "check": [
    "describe command('grep -rqE \\'^[^#]*Defaults[^#]*\\blogfile\\b\\' /etc/sudoers /etc/sudoers.d/ 2>/dev/null && echo ok || echo ko') do",
    "  its('stdout.strip') { should eq 'ok' }",
    "end"
  ],
  "remediation": {
    "content": "Defaults logfile=\"/var/log/sudo.log\"\n",
    "group": "root",
    "mode": "0440",
    "owner": "root",
    "path": "/etc/sudoers.d/99-pavois-logfile",
    "resource": "file",
    "verify": "visudo -cf %{path}"
  },
  "title": {
    "en": "Ensure Sudo Logfile Exists - sudo logfile",
    "fr": "Vérifier l'existence d'un fichier de journal sudo dédié"
  },
  "needs_translation": [
    "rationale.fr"
  ],
  "rationale": {
    "en": "A sudo log file simplifies auditing of sudo commands.",
    "fr": "A sudo log file simplifies auditing of sudo commands."
  },
  "needs_authoring": [
    "summary",
    "check_note",
    "verify",
    "logs",
    "remediation_note",
    "impact"
  ]
}
