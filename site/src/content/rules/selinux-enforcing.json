{
  "id": "selinux-enforcing",
  "supported_os": [
    "fedora",
    "rhel10",
    "rhel8",
    "rhel9"
  ],
  "os_versions": {
    "rhel10": "1.0.0",
    "rhel8": "4.0.0",
    "rhel9": "2.0.0"
  },
  "severity": "high",
  "domain": "Mandatory Access Control",
  "evidence_type": "effective-runtime",
  "reboot_survivable": "yes",
  "norms": {
    "bp28": "R37",
    "cis": "1.3.1.5",
    "nist": "AC-3",
    "pci-dss": "1.2.6"
  },
  "check": [
    "describe command('getenforce') do",
    "  its('stdout.strip') { should cmp 'Enforcing' }",
    "end",
    "describe file('/etc/selinux/config') do",
    "  its('content') { should match(/^SELINUX=enforcing/) }",
    "end"
  ],
  "remediation": {
    "resource": "selinux_state",
    "state": "enforcing"
  },
  "title": {
    "en": "Ensure SELinux State is Enforcing",
    "fr": "Ensure SELinux State is Enforcing"
  },
  "needs_translation": [
    "title.fr"
  ],
  "needs_authoring": [
    "summary",
    "check_note",
    "verify",
    "logs",
    "remediation_note",
    "impact"
  ]
}
