{
  "id": "firewall-default-deny",
  "supported_os": [
    "debian12"
  ],
  "os_versions": {
    "debian12": "1.1.0"
  },
  "severity": "medium",
  "domain": "Firewall",
  "evidence_type": "effective-runtime",
  "reboot_survivable": "no",
  "norms": {
    "cis": [
      "4.2.7",
      "4.3.8",
      "4.4.2.1"
    ],
    "nist": [
      "CA-3(5)",
      "CM-7(b)",
      "SC-7(23)",
      "CM-6(a)"
    ],
    "pci-dss": "1.3.1"
  },
  "check": [
    "describe command('if nft list ruleset 2>/dev/null | grep -qE \\'hook input.*policy drop\\' || iptables -S INPUT 2>/dev/null | grep -qE \\'^-P INPUT (DROP|REJECT)\\'; then echo ok; else echo ko; fi') do",
    "  its('stdout.strip') { should eq 'ok' }",
    "end"
  ],
  "remediation": {
    "default": "ufw",
    "options": {
      "firewalld": {
        "package": "firewalld",
        "service": "firewalld"
      },
      "nftables": {
        "package": "nftables",
        "service": "nftables"
      },
      "ufw": {
        "package": "ufw",
        "service": "ufw"
      }
    },
    "resource": "choose"
  },
  "title": {
    "en": "Ensure the Host Firewall Defaults to Deny (any backend)",
    "fr": "Vérifier que le pare-feu de l'hôte refuse par défaut (quel que soit le backend)"
  }
}
