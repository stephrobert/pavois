---
import Base from '../../layouts/Base.astro';
import { languages, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const fr = lang === 'fr';

const title = fr ? 'Rapport d’exemple' : 'Sample report';
const lede = fr
  ? 'Un vrai rapport Pavois sur une VM Debian 12 (données anonymisées). En bas : le rapport de campagne avant/après un durcissement complet, avec la matrice de transition.'
  : 'A real Pavois report on a Debian 12 VM (data anonymized). Below: the before/after hardening campaign report, with the transition matrix.';
---

<Base
  title={`Pavois, ${title}`}
  description={fr
    ? 'Exemple de rapport Pavois (scan réel, anonymisé) et rapport de campagne avant/après durcissement avec matrice de transition.'
    : 'Sample Pavois report (real scan, anonymized) and before/after hardening campaign report with transition matrix.'}
  lang={lang}
  breadcrumbs={[{ name: 'Pavois', path: `/${lang}/` }, { name: title, path: `/${lang}/sample-report/` }]}
>
  <div class="wrap page-head">
    <h1>{title}</h1>
    <p class="lede">{lede}</p>
  </div>

  <div class="wrap">
    <div class="prose">
      <h2 id="key-results">{fr ? 'Résultats clés' : 'Key results'}</h2>
      <table>
        <thead>
          <tr><th></th><th>{fr ? 'Avant' : 'Before'}</th><th>{fr ? 'Après (post-reboot)' : 'After (post-reboot)'}</th></tr>
        </thead>
        <tbody>
          <tr><td>{fr ? 'Note' : 'Grade'}</td><td>E</td><td>C</td></tr>
          <tr><td>{fr ? 'Conformes' : 'Passing'}</td><td>252 / 523</td><td>492 / 560</td></tr>
          <tr><td>{fr ? 'Critiques' : 'Critical'}</td><td>1</td><td>0</td></tr>
        </tbody>
      </table>
      <p>
        {fr
          ? 'Campagne : 212 corrigés, 32 devenus applicables et conformes, 58 encore en échec, 4 régressions. Re-scan après un vrai reboot (boot_id changé avant/après) : les PASS y sont reboot-proven. Le tout est empaquetable et vérifiable via pavois bundle verify (SHA-256 du manifeste + checksums).'
          : 'Campaign: 212 fixed, 32 newly applicable and passing, 58 still failing, 4 regressions. Re-scanned after a real reboot (boot_id changed before/after), so the passes are reboot-proven. The whole thing is packaged and verifiable with pavois bundle verify (manifest SHA-256 + checksums).'}
      </p>
    </div>
  </div>

  <div class="wrap sample-wrap">
    <div class="sample-head">
      <h2 id="scan">{fr ? 'Rapport de scan' : 'Scan report'}</h2>
      <a class="btn btn-ghost" href="/sample-report.html" target="_blank" rel="noopener">
        {fr ? 'Ouvrir en plein écran ↗' : 'Open full screen ↗'}
      </a>
    </div>
    <iframe class="sample-frame" src="/sample-report.html" loading="lazy"
      title={fr ? 'Rapport de scan Pavois' : 'Pavois scan report'}></iframe>

    <div class="sample-head">
      <h2 id="campaign">{fr ? 'Rapport de campagne (avant / après)' : 'Campaign report (before / after)'}</h2>
      <a class="btn btn-ghost" href="/sample-campaign.html" target="_blank" rel="noopener">
        {fr ? 'Ouvrir en plein écran ↗' : 'Open full screen ↗'}
      </a>
    </div>
    <p class="sample-intro">
      {fr
        ? 'Le rapport de campagne compare deux scans, avant et après un durcissement. Il affiche le delta de note (ici E vers C) et la matrice de transition : l’état de chaque contrôle avant puis après (corrigé, régression, devenu applicable, toujours en échec). On raisonne ainsi en transitions, pas en taux de réussite brut, car le périmètre applicable s’élargit quand la baseline installe des composants (auditd, AIDE...). Les régressions sont mises en avant : ce sont elles qu’un auditeur regarde en premier.'
        : 'The campaign report compares two scans, before and after a hardening round. It shows the grade delta (here E to C) and the transition matrix: every control’s state before and after (fixed, regressed, newly applicable, still failing). You reason in transitions, not a raw pass rate, because the applicable set grows when the baseline installs components (auditd, AIDE...). Regressions are surfaced first: that is what an auditor checks before anything else.'}
    </p>
    <iframe class="sample-frame" src="/sample-campaign.html" loading="lazy"
      title={fr ? 'Rapport de campagne Pavois' : 'Pavois campaign report'}></iframe>
  </div>
</Base>

<style>
  .sample-wrap {
    margin-bottom: 4rem;
  }
  .sample-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin: 2rem 0 0.75rem;
  }
  .sample-head h2 {
    margin: 0;
  }
  .sample-intro {
    max-width: 75ch;
    margin: 0 0 1rem;
    color: var(--tx-2, #4b5563);
  }
  .sample-frame {
    width: 100%;
    height: 85vh;
    min-height: 520px;
    border: 1px solid var(--line, #e5e7eb);
    border-radius: 12px;
    background: #fff;
  }
</style>
