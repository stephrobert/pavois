---
import Base from '../../layouts/Base.astro';
import { languages, type Lang } from '../../i18n/ui';
// The campaign figures were PROSE, and they described a campaign two weeks older than the artifact
// the page embeds: the text said "E to D, 56 still failing, 1 regression" while the report itself
// showed E to B. Read the numbers from the artifact the binary produced (`pavois diff --json`).
import campaign from '../../../public/sample-campaign.json';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const fr = lang === 'fr';

const c = campaign as {
  before: { grade: string; passed: number; total: number };
  after: { grade: string; passed: number; total: number };
  transitions: Record<string, number>;
};
const tr = c.transitions ?? {};
const fixed = tr['fail>pass'] ?? 0;
const newlyOk = tr['na>pass'] ?? 0;
const stillFailing = tr['fail>fail'] ?? 0;
const regressions = tr['pass>fail'] ?? 0;

// The full matrix, not a selection of it. Rendered from whatever buckets the campaign actually
// contains, so a future run with different transitions cannot silently drop one off the page.
const STATE_LABEL: Record<string, { en: string; fr: string }> = {
  pass: { en: 'passing', fr: 'conforme' },
  fail: { en: 'failing', fr: 'en échec' },
  na: { en: 'not applicable', fr: 'non applicable' },
  absent: { en: 'not in the corpus', fr: 'absent du corpus' },
  error: { en: 'errored', fr: 'en erreur' },
};
const MEANING: Record<string, { en: string; fr: string }> = {
  'pass>pass': { en: 'already compliant, and stayed so', fr: 'déjà conforme, et resté conforme' },
  'fail>pass': { en: 'fixed by the hardening', fr: 'corrigés par le durcissement' },
  'na>pass': { en: 'became applicable, and passed', fr: 'devenus applicables, et conformes' },
  'absent>pass': { en: 'added to the corpus between the two scans', fr: 'ajoutés au corpus entre les deux scans' },
  'fail>fail': { en: 'not closed by hardening', fr: 'non corrigés par le durcissement' },
  'na>na': { en: 'not applicable to this host, either time', fr: 'non applicables à cet hôte, avant comme après' },
  'fail>na': { en: 'stopped applying', fr: 'ont cessé de s’appliquer' },
  'pass>na': { en: 'stopped applying', fr: 'ont cessé de s’appliquer' },
  'pass>absent': { en: 'removed from the corpus', fr: 'retirés du corpus' },
  'pass>fail': { en: 'REGRESSED', fr: 'RÉGRESSION' },
};
const stateName = (k: string) => (STATE_LABEL[k] ? tr2(STATE_LABEL[k]) : k);
const tr2 = (f: { en: string; fr: string }) => (fr ? f.fr : f.en);
const matrix = Object.entries(tr)
  .filter(([, n]) => n > 0)
  .sort((a, b) => b[1] - a[1]);
const matrixTotal = matrix.reduce((a, [, n]) => a + n, 0);
// The reconciliation the page owes the reader: which buckets add up to "passing after".
const intoPass = matrix.filter(([k]) => k.endsWith('>pass'));
const outOfPass = matrix.filter(([k]) => k.startsWith('pass>'));
const sumOf = (rows: [string, number][]) => rows.reduce((a, [, n]) => a + n, 0);

const title = fr ? 'Rapport d’exemple' : 'Sample report';
const lede = fr
  ? 'Un vrai rapport Pavois sur une VM Debian 13 (données anonymisées). En bas : le rapport de campagne avant/après un durcissement complet, avec la matrice de transition.'
  : 'A real Pavois report on a Debian 13 VM (data anonymized). Below: the before/after hardening campaign report, with the transition matrix.';
---

<Base
  title={`Pavois, ${title}`}
  description={fr
    ? 'Exemple de rapport Pavois (scan réel, anonymisé) et rapport de campagne avant/après durcissement avec matrice de transition.'
    : 'Sample Pavois report (real scan, anonymized) and before/after hardening campaign report with transition matrix.'}
  lang={lang}
  breadcrumbs={[{ name: 'Pavois', path: `/${lang}/` }, { name: title, path: `/${lang}/sample-report/` }]}
>
  <div class="wrap page-head">
    <h1>{title}</h1>
    <p class="lede">{lede}</p>
  </div>

  <div class="wrap">
    <div class="prose">
      <h2 id="transition-matrix">{fr ? 'Matrice de transition' : 'Transition matrix'}</h2>
      <p>{fr
        ? `Les ${matrixTotal} contrôles du corpus, rangés par état avant puis après. Le tableau est publié en entier : additionner un sous-ensemble ne redonne pas le total, et un lecteur qui vérifie a le droit de le vérifier.`
        : `All ${matrixTotal} controls in the corpus, by state before and after. The table is published whole: adding up a subset does not reproduce the total, and a reader who checks is entitled to check.`}</p>
      <table>
        <thead>
          <tr>
            <th>{fr ? 'Avant' : 'Before'}</th>
            <th>{fr ? 'Après' : 'After'}</th>
            <th>{fr ? 'Nombre' : 'Count'}</th>
            <th>{fr ? 'Signification' : 'Meaning'}</th>
          </tr>
        </thead>
        <tbody>
          {matrix.map(([k, n]) => (
            <tr>
              <td>{stateName(k.split('>')[0])}</td>
              <td>{stateName(k.split('>')[1])}</td>
              <td><b>{n}</b></td>
              <td>{MEANING[k] ? tr2(MEANING[k]) : ''}</td>
            </tr>
          ))}
          <tr>
            <td colspan="2"><b>{fr ? 'Total' : 'Total'}</b></td>
            <td><b>{matrixTotal}</b></td>
            <td>{fr ? 'contrôles du corpus' : 'controls in the corpus'}</td>
          </tr>
        </tbody>
      </table>

      <h3>{fr ? 'Comment les totaux se referment' : 'How the totals close'}</h3>
      <p>{fr
        ? 'Deux additions valent d’être écrites, parce que ce sont celles qu’un lecteur refait de tête et rate : les conformes d’après ne se déduisent pas des conformes d’avant.'
        : 'Two sums are worth writing out, because they are the ones a reader redoes mentally and gets wrong: the passing count after does not follow from the passing count before.'}</p>
      <pre><code>{fr ? 'conformes après' : 'passing after'}  = {intoPass.map(([k, n]) => `${n}`).join(' + ')} = {sumOf(intoPass)}
{'  '}({intoPass.map(([k]) => k).join(', ')})

{fr ? 'conformes avant' : 'passing before'} = {outOfPass.map(([, n]) => `${n}`).join(' + ')} = {sumOf(outOfPass)}
{'  '}({outOfPass.map(([k]) => k).join(', ')})</code></pre>
      <p>{fr
        ? 'Le terme qui manque à une vérification rapide est pass>pass : il vaut 277, pas 279, parce que deux contrôles conformes avant ont quitté l’ensemble des conformes (l’un est devenu non applicable, l’autre a été retiré du corpus).'
        : 'The term a quick check misses is pass>pass: it is 277, not 279, because two controls that passed before left the passing set (one stopped applying, one was removed from the corpus).'}</p>

      <h2 id="key-results">{fr ? 'Résultats clés' : 'Key results'}</h2>
      <table>
        <thead>
          <tr><th></th><th>{fr ? 'Avant' : 'Before'}</th><th>{fr ? 'Après (post-reboot)' : 'After (post-reboot)'}</th></tr>
        </thead>
        <tbody>
          <tr><td>{fr ? 'Note' : 'Grade'}</td><td>{c.before.grade}</td><td>{c.after.grade}</td></tr>
          <tr><td>{fr ? 'Conformes' : 'Passing'}</td><td>{c.before.passed} / {c.before.total}</td><td>{c.after.passed} / {c.after.total}</td></tr>
        </tbody>
      </table>
      <p set:html={fr
        ? `Campagne : ${fixed} corrigés, ${newlyOk} devenus applicables et conformes, ${stillFailing} encore en échec, ${regressions} régression${regressions > 1 ? 's' : ''}. Le durcissement a CONVERGÉ (re-scan, re-plan, ré-application jusqu’au point fixe) : un seul apply n’y suffit pas, il crée lui-même des écarts qu’il ne peut pas voir. Re-scan après un vrai reboot (boot_id changé avant/après) : les PASS y sont reboot-proven. Le tout est empaquetable et vérifiable via <code>pavois bundle verify</code> (SHA-256 du manifeste + checksums).`
        : `Campaign: ${fixed} fixed, ${newlyOk} newly applicable and passing, ${stillFailing} still failing, ${regressions} regression${regressions > 1 ? 's' : ''}. The hardening CONVERGED (re-scan, re-plan, re-apply to a fixpoint): a single apply is not enough, it creates gaps it cannot itself see. Re-scanned after a real reboot (boot_id changed before/after), so the passes are reboot-proven. The whole thing is packaged and verifiable with <code>pavois bundle verify</code> (manifest SHA-256 + checksums).`} />

    </div>
  </div>

  <div class="wrap sample-wrap">
    <div class="sample-head">
      <h2 id="scan">{fr ? 'Rapport de scan' : 'Scan report'}</h2>
      <a class="btn btn-ghost" href="/sample-report.html" target="_blank" rel="noopener">
        {fr ? 'Ouvrir en plein écran ↗' : 'Open full screen ↗'}
      </a>
    </div>
    <iframe class="sample-frame" src="/sample-report.html" loading="lazy"
      title={fr ? 'Rapport de scan Pavois' : 'Pavois scan report'}></iframe>

    <div class="sample-head">
      <h2 id="campaign">{fr ? 'Rapport de campagne (avant / après)' : 'Campaign report (before / after)'}</h2>
      <a class="btn btn-ghost" href="/sample-campaign.html" target="_blank" rel="noopener">
        {fr ? 'Ouvrir en plein écran ↗' : 'Open full screen ↗'}
      </a>
    </div>
    <p class="sample-intro">
      {fr
        ? 'Le rapport de campagne compare deux scans, avant et après un durcissement. Il affiche le delta de note  et la matrice de transition : l’état de chaque contrôle avant puis après (corrigé, régression, devenu applicable, toujours en échec). On raisonne ainsi en transitions, pas en taux de réussite brut, car le périmètre applicable s’élargit quand la baseline installe des composants (auditd, AIDE...). Les régressions sont mises en avant : ce sont elles qu’un auditeur regarde en premier.'
        : 'The campaign report compares two scans, before and after a hardening round. It shows the grade delta and the transition matrix: every control’s state before and after (fixed, regressed, newly applicable, still failing). You reason in transitions, not a raw pass rate, because the applicable set grows when the baseline installs components (auditd, AIDE...). Regressions are surfaced first: that is what an auditor checks before anything else.'}
    </p>
    <iframe class="sample-frame" src="/sample-campaign.html" loading="lazy"
      title={fr ? 'Rapport de campagne Pavois' : 'Pavois campaign report'}></iframe>
  </div>
</Base>
