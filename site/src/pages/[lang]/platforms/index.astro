---
// The platform verification matrix (#351).
//
// Every row is generated by `mise run gen:platform-matrix`, which runs the same state machine that
// gates a release (`tools/release/evidence.py`). Nothing here is typed by hand, and that is the
// point: "supported", "curated" and "proved on a clean VM" are three different claims, and prose
// had been collapsing them into one.
//
// The six states may not be collapsed either. CURATED is not a soft VERIFIED: it means a corpus
// exists and no machine has ever run it. A campaign that is missing, interrupted or silent about
// which corpus it measured renders INCOMPLETE, never a pass.
import Base from '../../../layouts/Base.astro';
import { languages, type Lang } from '../../../i18n/ui';
import { osLabel, osFamily, osSortKey } from '../../../lib/os';
import matrix from '../../../data/platform-matrix.json';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const fr = lang === 'fr';
const origin = (Astro.site?.toString() ?? 'https://www.pavois.dev/').replace(/\/$/, '');

type Facet = {
  grade?: string | null;
  passed?: number | null;
  total?: number | null;
  platform?: string | null;
  pavois_version?: string | null;
} | null;

type Row = {
  os: string;
  state: string;
  reasons: string[];
  provenance: { ran_on: string; run_url: string | null };
  campaign: { id: string | null; ran_at: string | null; age_days: number | null };
  before: Facet;
  after: Facet;
};

// Fixed order: Debian, Ubuntu, RHEL family, Fedora, each by release number ascending. Deliberately
// NOT sorted by state. A table ranked by verdict reshuffles itself every time a campaign changes
// its mind, so the reader who comes back to check one distribution has to find it again. Here a row
// keeps its place for good and only its badge moves, which is what makes two visits comparable.
const rows = (matrix.platforms as Row[]).slice().sort((a, b) => {
  const [fa, va] = osSortKey(a.os);
  const [fb, vb] = osSortKey(b.os);
  return fa - fb || va - vb;
});

// Where a family starts, so the table can breathe between them without inventing header rows.
const firstOfFamily = new Set<string>();
const seenFamilies = new Set<string>();
for (const r of rows) {
  const f = osFamily(r.os);
  if (!seenFamilies.has(f)) {
    seenFamilies.add(f);
    firstOfFamily.add(r.os);
  }
}

const count = (s: string) => rows.filter((r) => r.state === s).length;

// The share of controls that passed, which is what the ring around a grade draws. The site already
// carries a grade badge in global.css, and its ring is frozen at 82% amber: two different grades
// would look identical on it. Here the ring is the measurement and the letter is the verdict, so
// the shape says something rather than decorating.
const pct = (f: Facet): number =>
  f?.passed && f?.total ? Math.round((100 * f.passed) / f.total) : 0;

// Targets whose id pins no version. `fedora` is the only one, deliberately: norms.yml records that
// no CIS benchmark exists for Fedora and that its mappings are inherited from rhel9, so the corpus
// is not written against a release number. That makes a verdict on it ambiguous in a way it is not
// for `debian12`, and the page has to say so rather than let VERIFIED read as "every Fedora". The
// list is derived, so it stays right if another unversioned target is ever added.
const unversioned = rows.filter((r) => !/\d/.test(r.os)).map((r) => osLabel(r.os));
const verified = count('VERIFIED');
const generated = (matrix.generated_at as string).slice(0, 10);

const t = {
  title: {
    en: 'Which Linux platforms Pavois has actually proved',
    fr: 'Les plateformes Linux que Pavois a réellement prouvées',
  },
  desc: {
    en: `Generated from the golden-path campaigns: ${verified} of ${rows.length} supported Linux systems have passed a full clean-VM run against the current rule base. The others are curated, not proved, and this page says which is which.`,
    fr: `Généré depuis les campagnes golden-path : ${verified} systèmes Linux sur ${rows.length} ont passé une campagne complète sur VM vierge avec la base de règles actuelle. Les autres sont curés, pas prouvés, et cette page dit lesquels.`,
  },
};

const stats = [
  { n: `${verified}/${rows.length}`, l: { en: 'proved on a clean VM', fr: 'prouvés sur VM vierge' } },
  { n: String(count('CURATED')), l: { en: 'curated, never campaigned', fr: 'curés, jamais campagnés' } },
  { n: `${matrix.freshness_window_days} d`, l: { en: 'freshness window', fr: 'fenêtre de fraîcheur' } },
  { n: generated, l: { en: 'matrix generated', fr: 'matrice générée' } },
];

const STATE_COPY: Record<string, { en: string; fr: string }> = {
  VERIFIED: {
    en: 'The last campaign passed, on this exact rule base, inside the freshness window.',
    fr: 'La dernière campagne est passée, sur cette base de règles exacte, dans la fenêtre de fraîcheur.',
  },
  FAILED: {
    en: 'The last campaign ran and a required stage failed. An older green run does not override it.',
    fr: 'La dernière campagne a tourné et une étape requise a échoué. Un run vert plus ancien ne l’annule pas.',
  },
  STALE: {
    en: 'It passed, but on a different rule base, or longer ago than the freshness window allows.',
    fr: 'Elle est passée, mais sur une autre base de règles, ou il y a plus longtemps que la fenêtre ne l’autorise.',
  },
  INCOMPLETE: {
    en: 'A campaign exists and does not say what it proved: interrupted, or silent about which rule base it measured.',
    fr: 'Une campagne existe et ne dit pas ce qu’elle a prouvé : interrompue, ou muette sur la base de règles mesurée.',
  },
  CURATED: {
    en: 'The rule corpus exists, curated and statically validated. No clean-VM campaign has ever run. Not a weaker pass: a different claim.',
    fr: 'Le corpus de règles existe, curé et validé statiquement. Aucune campagne sur VM vierge n’a jamais tourné. Pas un PASS plus faible : une autre affirmation.',
  },
  UNKNOWN: {
    en: 'Nothing to go on. Missing evidence never reads as a pass.',
    fr: 'Rien sur quoi s’appuyer. Une preuve absente ne se lit jamais comme un succès.',
  },
};

const crumbs = [
  { name: 'Pavois', path: `/${lang}/` },
  { name: fr ? 'Plateformes' : 'Platforms', path: `/${lang}/platforms/` },
];

const jsonld = [
  {
    '@type': 'Dataset',
    name: t.title[lang],
    description: t.desc[lang],
    url: `${origin}/${lang}/platforms/`,
    inLanguage: fr ? 'fr-FR' : 'en-US',
    dateModified: generated,
    creator: { '@id': `${origin}/#author` },
    distribution: [
      {
        '@type': 'DataDownload',
        encodingFormat: 'application/json',
        contentUrl: `${origin}/platform-matrix.json`,
      },
    ],
  },
];
---

<Base
  title={`${t.title[lang]} · Pavois`}
  description={t.desc[lang]}
  lang={lang}
  breadcrumbs={crumbs}
  jsonld={jsonld}
>
  <div class="wrap page-head">
    <h1>{t.title[lang]}</h1>
    <p class="lede">
      {fr ? (
        <>
          <b>{verified} systèmes sur {rows.length}</b> ont traversé une campagne complète sur VM
          vierge, avec la base de règles telle qu’elle est aujourd’hui. Chaque ligne est générée
          depuis ces campagnes par le contrôle qui verrouille une release : un système que personne
          n’a prouvé ne peut pas s’afficher comme prouvé.
        </>
      ) : (
        <>
          <b>{verified} of {rows.length}</b> supported systems have been through a full clean-VM
          campaign against the rule base as it stands today. Every row is generated from those
          campaigns by the same check that gates a release: a system nobody proved cannot appear
          as proved.
        </>
      )}
    </p>
  </div>

  <div class="wrap">
    <div class="stats pstats">
      {stats.map((s) => (
        <div class="stat">
          <div class="n">{s.n}</div>
          <div class="l">{s.l[lang]}</div>
        </div>
      ))}
    </div>

    <div class="rtable-wrap">
      <table class="rtable ptable">
        <thead>
          <tr>
            <th>{fr ? 'Plateforme' : 'Platform'}</th>
            <th>{fr ? 'État' : 'State'}</th>
            <th>{fr ? 'Dernière campagne' : 'Last campaign'}</th>
            <th>{fr ? 'Note avant → après' : 'Grade before → after'}</th>
            <th>Pavois</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((r) => (
            <tr class={firstOfFamily.has(r.os) ? 'famstart' : undefined}>
              <td>
                <span class="pname">{osLabel(r.os)}</span>
                {r.after?.platform && <span class="os">{r.after.platform}</span>}
              </td>
              <td>
                <span class={`sev st-${r.state.toLowerCase()}`}>{r.state}</span>
              </td>
              <td>
                {r.campaign.ran_at ? (
                  <>
                    <span class="secs">{r.campaign.ran_at.slice(0, 10)}</span>
                    {r.campaign.age_days !== null && (
                      <span class="os">
                        {fr
                          ? `il y a ${r.campaign.age_days} j`
                          : `${r.campaign.age_days} days ago`}
                        {' · '}
                        {r.provenance.ran_on === 'ci' ? 'CI' : fr ? 'poste' : 'workstation'}
                      </span>
                    )}
                  </>
                ) : (
                  <span class="os">{fr ? 'aucune' : 'none'}</span>
                )}
              </td>
              <td>
                {r.before?.grade && r.after?.grade ? (
                  <>
                    <span class="gpair">
                      <span class="gbadge" data-g={r.before.grade} style={`--pct:${pct(r.before)}%`}>
                        <i>{r.before.grade}</i>
                      </span>
                      <span class="garrow">→</span>
                      <span class="gbadge" data-g={r.after.grade} style={`--pct:${pct(r.after)}%`}>
                        <i>{r.after.grade}</i>
                      </span>
                    </span>
                    <span class="os">{r.after.passed}/{r.after.total} ({pct(r.after)}%)</span>
                  </>
                ) : (
                  <span class="os">—</span>
                )}
              </td>
              <td><span class="secs">{r.after?.pavois_version ?? '—'}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="pnote">
      {fr
        ? `Fenêtre de fraîcheur : ${matrix.freshness_window_days} jours. Au-delà, une campagne passée bascule en STALE même si la base de règles n’a pas bougé : ce sont les paquets et le noyau de la cible qui ont bougé, et aucune empreinte de notre côté ne peut le voir.`
        : `Freshness window: ${matrix.freshness_window_days} days. Past it, a passing campaign turns STALE even when the rule base has not moved: the target’s own packages and kernel have, and no digest of ours can see that.`}
    </p>

    {unversioned.length > 0 && (
      <p class="pnote">
        {fr
          ? `Le corpus de ${unversioned.join(', ')} ne vise aucun numéro de version : le rapport de normes le documente, aucun benchmark CIS n’existe pour Fedora et ses mappings sont hérités de RHEL 9. Un verdict y porte donc sur la version effectivement mesurée, celle qui est nommée sous le libellé, et pas sur la distribution entière.`
          : `The ${unversioned.join(', ')} corpus targets no release number: the norms reference records that no CIS benchmark exists for Fedora and that its mappings are inherited from RHEL 9. A verdict there covers the version actually measured, the one named under the label, not the distribution as a whole.`}
      </p>
    )}

    <h2 class="sechead">{fr ? 'Ce que chaque état veut dire' : 'What each state means'}</h2>
    <div class="legend">
      {(matrix.states as string[]).map((s) => (
        <div class="card lcard">
          <span class={`sev st-${s.toLowerCase()}`}>{s}</span>
          <p>{STATE_COPY[s]?.[lang]}</p>
        </div>
      ))}
    </div>
  </div>

  <div class="wrap prose pwhy">
    <h2>{fr ? 'Pourquoi cette page existe' : 'Why this page exists'}</h2>
    <p>
      {fr
        ? 'Pour un outil de durcissement, la cadence des releases est un mauvais signal de maturité. Un bon signal, c’est ce que les campagnes ont réellement démontré, machine par machine, et ce que personne n’a encore démontré. Les deux se publient ici.'
        : 'For a hardening tool, release velocity is a poor maturity signal. A good one is what the campaigns have actually demonstrated, machine by machine, and what nobody has demonstrated yet. Both are published here.'}
    </p>
    <p>
      {fr
        ? 'Une campagne, c’est une VM vierge créée pour l’occasion : scan de la machine d’origine, plan, application, redémarrage, deuxième passe replanifiée depuis l’état courant, redémarrage, nouveau scan, diff, puis un bundle de preuves qui est vérifié. Un conteneur ne peut pas la remplacer : 259 des contrôles n’ont aucun sens sans un noyau à soi.'
        : 'A campaign is a clean VM created for it: scan the stock machine, plan, apply, reboot, a second pass re-planned from the current state, reboot, scan again, diff, then an evidence bundle that is verified. A container cannot stand in for it: 259 of the controls are meaningless without a kernel of your own.'}
    </p>
    <p>
      {fr
        ? 'La donnée brute derrière cette page est servie telle quelle, débarrassée de toute identité machine : '
        : 'The raw data behind this page is served as is, with machine identity removed: '}
      <a href="/platform-matrix.json">platform-matrix.json</a>.
    </p>
  </div>
</Base>

<style>
  /* KPI row: same .stat rhythm as the home page, laid out for four short figures. */
  .pstats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    margin: 4px 0 26px;
  }
  .pstats .stat {
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--panel);
    padding: 16px 18px;
  }
  .pstats .n {
    font-family: var(--font-disp);
    font-size: 26px;
    font-weight: 700;
    color: var(--tx);
    line-height: 1.1;
  }
  .pstats .l {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--tx-2);
    margin-top: 6px;
  }

  .ptable td { vertical-align: top; }
  /* One family from the next. A separator rather than a header row: the families are legible from
     the names, and an extra row per family would push the nine platforms off a laptop screen. */
  .ptable tbody tr.famstart td { border-top: 1px solid var(--line-2); }
  .ptable tbody tr.famstart:first-child td { border-top: none; }
  .ptable .pname { color: var(--tx); font-weight: 600; display: block; }
  .ptable .os { display: block; margin-top: 3px; }
  /* The grade badge: a ring whose filled arc IS the pass ratio, a panel, and the letter. The site
     has a `.grade` in global.css with the same silhouette, and it is unusable here: its arc is
     hardcoded at 82% amber, so an E and a B would draw the same picture. */
  .gpair { display: inline-flex; align-items: center; gap: 9px; }
  .gbadge {
    position: relative;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    flex: none;
    display: inline-grid;
    place-items: center;
    background: conic-gradient(var(--gc) 0 var(--pct, 0%), var(--line-2) var(--pct, 0%) 100%);
  }
  .gbadge i {
    position: absolute;
    inset: 4px;
    border-radius: 7px;
    background: var(--panel);
    display: grid;
    place-items: center;
    font-family: var(--font-disp);
    font-style: normal;
    font-weight: 800;
    font-size: 15px;
    color: var(--gc);
  }
  .gbadge[data-g='A'], .gbadge[data-g='B'] { --gc: var(--okt); }
  .gbadge[data-g='C'] { --gc: var(--warn); }
  .gbadge[data-g='D'], .gbadge[data-g='E'] { --gc: var(--red); }
  .garrow { color: var(--tx-3); font-size: 15px; }

  /* State pills: the .sev base (mono, uppercase, fixed width) with the site's semantic colours.
     Solid where the state is a verdict, outlined where it describes an absence of evidence, so
     CURATED cannot be mistaken at a glance for a weaker green. */
  .st-verified { color: #fff; background: var(--okt); border-color: var(--okt); }
  .st-failed { color: #fff; background: var(--red); border-color: var(--red); }
  .st-stale { color: var(--sev-med-tx); background: var(--sev-med); border-color: var(--sev-med); }
  .st-incomplete { color: var(--warn); background: transparent; border-color: var(--warn); }
  .st-curated { color: var(--tx-2); background: transparent; border-color: var(--line-2); }
  .st-unknown { color: var(--tx-3); background: transparent; border-color: var(--line); }

  .pnote {
    font-size: 13px;
    color: var(--tx-2);
    margin: 14px 0 0;
    max-width: 78ch;
  }

  /* Same scale as `.prose h2` in global.css, on purpose: the page carries two h2 and they must not
     be two different headings. The site's display face is --font-disp (Sora), not --font-display. */
  .sechead {
    font-family: var(--font-disp);
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--tx);
    margin: 48px 0 16px;
  }
  .legend {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .lcard { padding: 18px; }
  .lcard p {
    margin: 11px 0 0;
    font-size: 13.5px;
    line-height: 1.55;
    color: var(--tx-2);
  }
  /* `.prose h2:first-child` drops its top margin to 8px, which is right when a prose block opens a
     page and wrong here, where it follows the legend and was landing against it. The spacing goes
     on the section rather than on the heading, so the global rhythm (48px) is reproduced, not
     fought. */
  .pwhy {
    margin-top: 40px;
    padding-bottom: 72px;
  }

  @media (max-width: 900px) {
    .pstats { grid-template-columns: repeat(2, 1fr); }
    .legend { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 620px) {
    .legend { grid-template-columns: 1fr; }
    .ptable { font-size: 12.5px; }
  }
</style>
