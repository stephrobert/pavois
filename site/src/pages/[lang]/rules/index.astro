---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { ui, languages, type Lang } from '../../../i18n/ui';
import socleRefs from '../../../data/socle-refs.json';
import { coverageLevel, coverageLabel } from '../../../data/coverage';
import { domainLabel } from '../../../data/domain-labels';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const t = ui[lang];
const rules = (await getCollection('rules')).sort((a, b) =>
  (a.data.domain || '').localeCompare(b.data.domain || '') || a.data.title[lang].localeCompare(b.data.title[lang])
);
const domains = [...new Set(rules.map((r) => r.data.domain).filter(Boolean))].sort();
const order = { critical: 0, high: 1, medium: 2, low: 3, unknown: 4 } as Record<string, number>;
const sevs = [...new Set(rules.map((r) => r.data.severity))].sort((a, b) => order[a] - order[b]);
const STD = ['cis', 'bp28', 'nist', 'pci-dss', 'stig'];
const STD_LABEL: Record<string, string> = { cis: 'CIS', bp28: 'ANSSI-BP-028', nist: 'NIST', 'pci-dss': 'PCI-DSS', stig: 'STIG' };
const oses = [...new Set(rules.flatMap((r) => r.data.supported_os))].sort();
const sevLabel = (s: string): string => (t.sev as Record<string, string>)[s] ?? s;
const sevClass = (s: string): string => (s === 'medium' ? 'med' : s === 'unknown' ? 'na' : s);
const socleOf = (id: string): string => (socleRefs as Record<string, string>)[id] ?? '';
const normKeys = (n: Record<string, any>) =>
  STD.filter((k) => (Array.isArray(n[k]) ? n[k].length : n[k] != null && n[k] !== ''));
const intro = {
  en: 'Each control declares the evidence it gathers, resolved runtime state where a service exposes it (sshd -T, sysctl, systemctl, auditctl), otherwise persistent config, inventory or filesystem state. Filter by domain, severity, standard or OS, each row links to its check, evidence type, remediation and mappings.',
  fr: 'Chaque contrôle indique la preuve qu’il collecte, état résolu en cours d’exécution quand un service l’expose (sshd -T, sysctl, systemctl, auditctl), sinon config persistante, inventaire ou système de fichiers. Filtre par domaine, sévérité, norme ou OS, chaque ligne mène au check, au type de preuve, à la remédiation et aux mappings.',
};
// Windowed table: the first INITIAL rows are server-rendered (SEO + LCP + no-JS fallback); the full
// dataset ships as JSON and the client renders a scroll/filter-driven window from it (small DOM).
const INITIAL = 60;
const covTitle = (cov: string): string =>
  lang === 'fr'
    ? cov === 'shallow'
      ? 'Domaine peu couvert aujourd’hui, voir la page Couverture'
      : 'Domaine partiellement couvert, voir la page Couverture'
    : cov === 'shallow'
      ? 'Shallow domain today, see the Coverage page'
      : 'Partially covered today, see the Coverage page';
const rowsData = rules.map((r) => {
  const ks = normKeys(r.data.norms);
  const cov = coverageLevel(r.data.domain);
  return {
    id: r.data.id,
    socle: socleOf(r.data.id),
    title: r.data.title[lang],
    domain: r.data.domain || '',
    domainLabel: domainLabel(r.data.domain || '', lang),
    cov: cov === 'deep' ? '' : cov,
    covLabel: cov !== 'deep' ? coverageLabel[cov][lang] : '',
    covTitle: cov !== 'deep' ? covTitle(cov) : '',
    sev: r.data.severity,
    sevClass: sevClass(r.data.severity),
    sevLabel: sevLabel(r.data.severity),
    os: r.data.supported_os.length,
    osList: r.data.supported_os.join(' '),
    std: ks,
    search: `${r.data.title[lang]} ${r.data.domain} ${socleOf(r.data.id)} ${ks.join(' ')}`.toLowerCase(),
  };
});
---

<Base schema="CollectionPage" collectionSize={rules.length} title={`Pavois, ${t.rules}`} description={intro[lang]} lang={lang} breadcrumbs={[{ name: 'Pavois', path: `/${lang}/` }, { name: t.rules, path: `/${lang}/rules/` }]}>
  <div class="wrap page-head">
    <h1>{lang === 'fr' ? 'Tous les contrôles' : 'All controls'}</h1>
    <p class="lede">{intro[lang]}</p>
  </div>

  <div class="wrap">
    <div class="filterbar">
      <div class="fsel fsearch-wrap">
        <label>{lang === 'fr' ? 'Recherche' : 'Search'}</label>
        <input id="r-search" class="fsearch" type="search" placeholder={t.searchPh} autocomplete="off" />
      </div>
      <div class="fsel">
        <label>{t.domain}</label>
        <select id="r-domain" aria-label={t.domain}>
          <option value="">{lang === 'fr' ? 'Tous les domaines' : 'All domains'}</option>
          {domains.map((d) => <option value={d}>{domainLabel(d, lang)}</option>)}
        </select>
      </div>
      <div class="fsel">
        <label>{t.severity}</label>
        <select id="r-sev" aria-label={t.severity}>
          <option value="">{lang === 'fr' ? 'Toutes sévérités' : 'Any severity'}</option>
          {sevs.map((s) => <option value={s}>{sevLabel(s)}</option>)}
        </select>
      </div>
      <div class="fsel">
        <label>{t.standards}</label>
        <select id="r-std" aria-label={t.standards}>
          <option value="">{lang === 'fr' ? 'Toutes normes' : 'Any standard'}</option>
          {STD.map((s) => <option value={s}>{STD_LABEL[s]}</option>)}
        </select>
      </div>
      <div class="fsel">
        <label>{t.thOs}</label>
        <select id="r-os" aria-label={t.thOs}>
          <option value="">{t.allOs}</option>
          {oses.map((o) => <option value={o}>{o}</option>)}
        </select>
      </div>
      <div class="fcount"><b id="r-count">{rules.length}</b> / {rules.length} {lang === 'fr' ? 'règles' : 'rules'}</div>
    </div>

    <div class="rtable-wrap">
      <table class="rtable">
        <thead>
          <tr>
            <th data-col>{lang === 'fr' ? 'Réf.' : 'Ref'}</th>
            <th data-col>{t.thRule}</th>
            <th data-col>{t.domain}</th>
            <th data-col>{lang === 'fr' ? 'Sév.' : 'Sev.'}</th>
            <th data-col>{t.thOs}</th>
            <th data-col>{t.standards}</th>
          </tr>
        </thead>
        <tbody id="r-body">
          {
            rules.slice(0, INITIAL).map((r) => {
              const ks = normKeys(r.data.norms);
              return (
                <tr
                  data-domain={r.data.domain || ''}
                  data-sev={r.data.severity}
                  data-std={ks.join(' ')}
                  data-os={r.data.supported_os.join(' ')}
                  data-search={`${r.data.title[lang]} ${r.data.domain} ${socleOf(r.data.id)} ${ks.join(' ')}`.toLowerCase()}
                >
                  <td><a class="ref" href={`/${lang}/rules/${r.data.id}/`}>{socleOf(r.data.id)}</a></td>
                  <td><a class="rule-name" href={`/${lang}/rules/${r.data.id}/`}>{r.data.title[lang]}</a></td>
                  <td class="dom">{domainLabel(r.data.domain || '', lang)}{coverageLevel(r.data.domain) !== 'deep' && (
                    <a class={`covb covb-${coverageLevel(r.data.domain)}`} href={`/${lang}/handbook/coverage/`} title={lang === 'fr'
                      ? (coverageLevel(r.data.domain) === 'shallow' ? 'Domaine peu couvert aujourd’hui, voir la page Couverture' : 'Domaine partiellement couvert, voir la page Couverture')
                      : (coverageLevel(r.data.domain) === 'shallow' ? 'Shallow domain today, see the Coverage page' : 'Partially covered today, see the Coverage page')}>{coverageLabel[coverageLevel(r.data.domain)][lang]}</a>
                  )}</td>
                  <td><span class={`sev ${sevClass(r.data.severity)}`}>{sevLabel(r.data.severity)}</span></td>
                  <td class="os">{r.data.supported_os.length}</td>
                  <td><div class="tags">{ks.map((k, i) => <Fragment>{i > 0 ? ' ' : ''}<span class="tag">{k}</span></Fragment>)}</div></td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
    <p id="r-empty" hidden class="empty" data-msg={t.noResults}></p>
  </div>
  <script id="r-data" type="application/json" is:inline set:html={JSON.stringify(rowsData)} />
</Base>

<script>
  // Windowed table. The server renders the first rows for SEO/LCP/no-JS; on load we take over from
  // the full JSON dataset, rendering a 60-row window that grows on scroll and re-renders on filter/sort.
  const $ = (id: string) => document.getElementById(id);
  const search = $('r-search') as HTMLInputElement | null;
  const domain = $('r-domain') as HTMLSelectElement | null;
  const sev = $('r-sev') as HTMLSelectElement | null;
  const std = $('r-std') as HTMLSelectElement | null;
  const os = $('r-os') as HTMLSelectElement | null;
  const tbody = $('r-body');
  const count = $('r-count');
  const empty = $('r-empty');
  const dataEl = $('r-data');

  if (tbody && dataEl) {
    const ALL = JSON.parse(dataEl.textContent || '[]') as any[];
    const lang = document.documentElement.lang || 'en';
    const CHUNK = 60;
    const esc = (s: any) =>
      String(s).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c] as string);
    const rowHTML = (d: any) =>
      `<tr data-domain="${esc(d.domain)}" data-sev="${esc(d.sev)}" data-std="${esc(d.std.join(' '))}" data-os="${esc(d.osList)}" data-search="${esc(d.search)}">` +
      `<td><a class="ref" href="/${lang}/rules/${d.id}/">${esc(d.socle)}</a></td>` +
      `<td><a class="rule-name" href="/${lang}/rules/${d.id}/">${esc(d.title)}</a></td>` +
      `<td class="dom">${esc(d.domainLabel)}${d.cov ? `<a class="covb covb-${d.cov}" href="/${lang}/handbook/coverage/" title="${esc(d.covTitle)}">${esc(d.covLabel)}</a>` : ''}</td>` +
      `<td><span class="sev ${d.sevClass}">${esc(d.sevLabel)}</span></td>` +
      `<td class="os">${d.os}</td>` +
      `<td><div class="tags">${d.std.map((k: string) => `<span class="tag">${esc(k)}</span>`).join(' ')}</div></td>` +
      `</tr>`;

    let view: any[] = ALL;
    let shown = 0;
    let sortIdx = -1;
    let sortAsc = true;
    const key = (d: any, i: number) => [d.socle, d.title, d.domain, d.sevLabel, d.os, d.std.join(' ')][i];

    const renderMore = () => {
      const next = view.slice(shown, shown + CHUNK);
      if (next.length) tbody.insertAdjacentHTML('beforeend', next.map(rowHTML).join(''));
      shown += next.length;
    };
    const apply = () => {
      const q = (search?.value || '').trim().toLowerCase();
      const d = domain?.value || '';
      const s = sev?.value || '';
      const st = std?.value || '';
      const o = os?.value || '';
      view = ALL.filter(
        (r) =>
          (!q || r.search.includes(q)) &&
          (!d || r.domain === d) &&
          (!s || r.sev === s) &&
          (!st || r.std.includes(st)) &&
          (!o || r.osList.split(' ').includes(o))
      );
      if (sortIdx >= 0)
        view = [...view].sort(
          (a, b) => (sortAsc ? 1 : -1) * String(key(a, sortIdx)).localeCompare(String(key(b, sortIdx)), undefined, { numeric: true })
        );
      tbody.innerHTML = '';
      shown = 0;
      renderMore();
      if (count) count.textContent = String(view.length);
      if (empty) {
        const show = view.length === 0;
        (empty as HTMLElement).hidden = !show;
        // The message lives in data-msg, never in the static body, so the no-JS export stays clean.
        if (show && !empty.textContent) empty.textContent = (empty as HTMLElement).dataset.msg || '';
      }
    };

    [search, domain, sev, std, os].forEach((el) => {
      el?.addEventListener('input', apply);
      el?.addEventListener('change', apply);
    });
    const heads = Array.from(document.querySelectorAll('.rtable th[data-col]')) as HTMLElement[];
    heads.forEach((th, idx) => {
      th.addEventListener('click', () => {
        sortAsc = sortIdx === idx ? !sortAsc : true;
        sortIdx = idx;
        heads.forEach((o) => (o.dataset.dir = ''));
        th.dataset.dir = sortAsc ? 'asc' : 'desc';
        apply();
      });
    });
    window.addEventListener(
      'scroll',
      () => {
        if (shown < view.length && window.innerHeight + window.scrollY >= document.body.offsetHeight - 700) renderMore();
      },
      { passive: true }
    );
    apply(); // take over the server-rendered rows with the windowed dataset
  }
</script>
