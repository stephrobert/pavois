---
import Base from '../../layouts/Base.astro';
import Toc from '../../components/Toc.astro';
import { languages, type Lang } from '../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const { lang } = Astro.params as { lang: Lang };
const fr = lang === 'fr';

const sections = [
  { slug: 'prerequisites', en: 'Prerequisites', fr: 'Prérequis' },
  { slug: 'build', en: '1. Build from source', fr: '1. Construire depuis les sources' },
  { slug: 'scan', en: '2. First scan', fr: '2. Premier scan' },
  { slug: 'harden', en: '3. Harden, then prove', fr: '3. Durcir, puis prouver' },
  { slug: 'takeaways', en: 'Key takeaways', fr: 'À retenir' },
  { slug: 'next', en: 'Next steps', fr: 'Prochaines étapes' },
];
const toc = sections.map((s) => ({ depth: 2, slug: s.slug, text: fr ? s.fr : s.en }));

const title = fr ? 'Démarrer · Pavois' : 'Get started · Pavois';
const desc = fr
  ? 'Construis Pavois depuis les sources, lance ton premier scan A à E, puis durcis une cible et re-scanne. Trois commandes, du build au verdict.'
  : 'Build Pavois from source, run your first A to E scan, then harden a target and re-scan. Three commands, from build to verdict.';
const crumbs = [
  { name: 'Pavois', path: `/${lang}/` },
  { name: fr ? 'Démarrer' : 'Get started', path: `/${lang}/start/` },
];
---

<Base title={title} description={desc} lang={lang} breadcrumbs={crumbs}>
  <div class="wrap layout-doc">
   <main>
    <article class="start">
    <span class="eyebrow">{fr ? 'Démarrer' : 'Get started'}</span>
    <h1>{fr ? 'De la source au verdict en trois commandes' : 'From source to verdict in three commands'}</h1>
    <p class="lede">{desc}</p>

    <h2 id="prerequisites">{fr ? 'Prérequis' : 'Prerequisites'}</h2>
    <p>
      {fr
        ? 'Pavois est un binaire Go au-dessus de CINC Auditor (build open-source de Chef InSpec). La chaîne d’outils est épinglée par '
        : 'Pavois is a Go binary on top of CINC Auditor (the open-source build of Chef InSpec). The toolchain is pinned by '}
      <a href="https://mise.jdx.dev" target="_blank" rel="noopener">mise</a>
      {fr
        ? '. CINC Auditor s’installe en natif au premier scan (via omnitruck) ; un conteneur Docker sert de repli.'
        : '. CINC Auditor installs natively on the first scan (via omnitruck); a Docker container is the fallback.'}
    </p>

    <h2 id="build">{fr ? '1. Construire depuis les sources' : '1. Build from source'}</h2>
    <p>{fr ? 'Clone le dépôt, installe la chaîne épinglée, compile le binaire :' : 'Clone the repository, install the pinned toolchain, compile the binary:'}</p>
    <pre class="code mono"><code>git clone https://github.com/stephrobert/pavois.git
cd pavois
mise trust &amp;&amp; mise install   # {fr ? 'Go, Node, Python épinglés' : 'pinned Go, Node, Python'}
mise run build                # -&gt; go/pavois</code></pre>
    <p class="muted">{fr ? 'Vérifie : ' : 'Verify: '}<code class="mono">./go/pavois version</code> {fr ? 'affiche la version.' : 'prints the version.'}</p>

    <h2 id="scan">{fr ? '2. Premier scan (note A à E)' : '2. First scan (A to E grade)'}</h2>
    <p>{fr ? 'Audite une cible SSH avec sudo (la config effective exige root) :' : 'Audit an SSH target with sudo (effective config needs root):'}</p>
    <pre class="code mono"><code>./go/pavois scan user@host --key ~/.ssh/id_ed25519 \
  --sudo --profile profiles/linux/debian12</code></pre>
    <p>
      {fr
        ? 'La sortie liste les écarts par sévérité et affiche la note A à E en grosse lettre, plus le chemin du rapport HTML. Pour servir les rapports : '
        : 'The output lists deviations by severity and prints the A to E grade as a large letter, plus the HTML report path. To serve reports: '}
      <code class="mono">./go/pavois serve</code> {fr ? '(http://localhost:8098).' : '(http://localhost:8098).'}
    </p>
    <p>
      <a href="/sample-report.html" target="_blank" rel="noopener">{fr ? 'Voir un rapport d’exemple (scan réel) →' : 'See a sample report (real scan) →'}</a>
    </p>

    <h2 id="harden">{fr ? '3. Durcir, puis prouver' : '3. Harden, then prove'}</h2>
    <p>{fr ? 'Planifie les correctifs, active ceux que tu veux, converge un run Chef natif, et re-scanne :' : 'Plan the fixes, opt into the ones you want, converge a native Chef run, and re-scan:'}</p>
    <pre class="code mono"><code>./go/pavois harden plan user@host --key ~/.ssh/id_ed25519 --sudo
# {fr ? 'édite le plan : passe des règles à apply: true' : 'edit the plan: flip rules to apply: true'}
./go/pavois harden apply hardening-plan-debian12.yml --scan</code></pre>
    <p>
      {fr
        ? 'Ajoute --reboot pour redémarrer la cible et re-scanner après le boot : un PASS y est alors reboot-proven. '
        : 'Add --reboot to reboot the target and re-scan after boot: a PASS there is reboot-proven. '}
      <a href={`/${lang}/handbook/qualified-verdict/`}>{fr ? 'Voir le verdict qualifié.' : 'See the qualified verdict.'}</a>
    </p>

    <h2 id="takeaways">{fr ? 'À retenir' : 'Key takeaways'}</h2>
    <ul>
      <li>{fr ? 'Trois commandes : ' : 'Three commands: '}<code class="mono">build</code>, <code class="mono">scan</code>, <code class="mono">harden</code>.</li>
      <li>{fr ? 'Pas d’agent : Pavois utilise ton ~/.ssh/config et ton sudo, comme oscap/lynis.' : 'No agent: Pavois uses your ~/.ssh/config and your sudo, like oscap/lynis.'}</li>
      <li>{fr ? 'Un A net exige une posture reboot-proof, pas seulement active.' : 'A clean A requires a reboot-proof posture, not just a live one.'}</li>
    </ul>

    <h2 id="next">{fr ? 'Prochaines étapes' : 'Next steps'}</h2>
    <ul>
      <li><a href={`/${lang}/docs/`}>{fr ? 'Comment ça marche' : 'How it works'}</a></li>
      <li><a href={`/${lang}/rules/`}>{fr ? 'Parcourir les contrôles' : 'Browse the controls'}</a></li>
      <li><a href={`/${lang}/handbook/scoring-methodology/`}>{fr ? 'Comment la note est calculée' : 'How the grade is computed'}</a></li>
    </ul>
    </article>
   </main>
   <Toc headings={toc} lang={lang} />
  </div>
</Base>

<style>
  .start {
    max-width: 800px;
    padding-top: 40px;
    padding-bottom: 60px;
  }
  .start h1 {
    font-size: clamp(1.9rem, 4.5vw, 2.8rem);
    margin: 8px 0 14px;
  }
  .start .lede {
    font-size: 1.12rem;
    line-height: 1.6;
    color: var(--color-dim);
    margin-bottom: 12px;
  }
  .start h2 {
    margin-top: 34px;
  }
  .start pre.code {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: 14px 16px;
    overflow: auto;
    font-size: 0.82rem;
    line-height: 1.55;
  }
  .start ul {
    line-height: 1.7;
  }
  .start a {
    color: var(--color-accent);
  }
</style>
