---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import Toc from '../../../components/Toc.astro';
import { ui, languages, type Lang } from '../../../i18n/ui';
import { renderMarkdown } from '../../../lib/markdown';

export async function getStaticPaths() {
  const pages = await getCollection('handbook');
  return Object.keys(languages).flatMap((lang) =>
    pages.map((p) => ({ params: { lang, id: p.data.id }, props: { page: p.data } }))
  );
}

const { lang } = Astro.params as { lang: Lang };
const { page } = Astro.props;
const t = ui[lang];
// Content bodies use root-relative internal links (/handbook/x/, /downloads/…) so they stay
// lang-agnostic; rewrite them to the current language at render time.
// Every prefix the site actually has. A missing one is not a missing style, it is a 404: a link
// written /start/ in the prose stayed unprefixed, and the site has no page outside /en/ and /fr/.
const INTERNAL =
  'handbook|rules|standards|docs|glossary|downloads|attribution|sample-report|start|installation|audit|blog|about';
const { html: bodyHtml, headings } = renderMarkdown(page.body[lang], { lang, internal: INTERNAL });

// FAQPage JSON-LD: parse the `## FAQ` section (blocks of `**Question?** Answer.`) so the Q&A is
// eligible for rich results and, above all, gets cited by answer engines (GEO). Strip inline
// markdown so the structured text is clean. Emitted only when there are at least two real pairs.
const stripMd = (s: string) => s.replace(/[*`]/g, '').replace(/\s+/g, ' ').trim();
function extractFaq(md: string): { q: string; a: string }[] {
  const after = md.split(/^##\s+FAQ\s*$/m)[1];
  if (!after) return [];
  const section = after.split(/^##\s/m)[0];
  return section
    .split(/\n\n+/)
    .map((b) => b.trim())
    .map((b) => b.match(/^\*\*(.+?)\*\*\s*([\s\S]+)$/))
    .filter((m): m is RegExpMatchArray => !!m)
    .map((m) => ({ q: stripMd(m[1]), a: stripMd(m[2]) }))
    .filter((qa) => qa.q && qa.a);
}
// The lede (page.summary) is rendered as a bare string, so any **bold** / `code` markdown showed
// literally. Render the inline markdown for the visible lede, and strip it for the meta description
// (a meta tag must be plain text, never carry `**` or backticks into search snippets).
const inlineMd = (s: string) =>
  s
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
    .replace(/`([^`]+)`/g, '<code>$1</code>');
const ledeHtml = inlineMd(page.summary?.[lang] ?? '');
const metaDesc = (page.summary?.[lang] ?? '')
  .replace(/\*\*(.+?)\*\*/g, '$1')
  .replace(/`([^`]+)`/g, '$1');

const faq = extractFaq(page.body[lang]);
const faqLd =
  faq.length >= 2
    ? {
        '@type': 'FAQPage',
        mainEntity: faq.map(({ q, a }) => ({
          '@type': 'Question',
          name: q,
          acceptedAnswer: { '@type': 'Answer', text: a },
        })),
      }
    : undefined;

const all = (await getCollection('handbook')).sort((a, b) => (a.data.order || 0) - (b.data.order || 0));
const SECTIONS = ['foundations', 'domains', 'tooling'] as const;
const secLabel: Record<string, { en: string; fr: string }> = {
  foundations: { en: 'Foundations', fr: 'Fondations' },
  domains: { en: 'Domains', fr: 'Domaines' },
  tooling: { en: 'Tooling', fr: 'Outillage' },
};
const grouped = SECTIONS.map((s) => ({
  section: s,
  pages: all.filter((p) => p.data.section === s),
})).filter((g) => g.pages.length);

const relatedRules = page.domain
  ? (await getCollection('rules'))
      .filter((r) => r.data.domain === page.domain)
      .sort((a, b) => a.data.id.localeCompare(b.data.id))
  : [];
const sectionOf = secLabel[page.section]?.[lang]?.toLowerCase() ?? '';
const crumbs = [
  { name: 'Pavois', path: `/${lang}/` },
  { name: t.navHandbook, path: `/${lang}/handbook/` },
  { name: page.title[lang], path: `/${lang}/handbook/${page.id}/` },
];
---

<Base
  title={`${page.title[lang]} · Pavois`}
  description={metaDesc}
  lang={lang}
  ogType="article"
  schema="TechArticle"
  datePublished={page.datePublished}
  dateModified={page.dateModified ?? page.datePublished}
  breadcrumbs={crumbs}
  jsonld={faqLd}
>
  <div class="wrap layout-book has-toc">
    <aside class="side">
      {
        grouped.map((g) => (
          <details class="sgroup" open={g.pages.some((p) => p.data.id === page.id)}>
            <summary>{secLabel[g.section][lang]}</summary>
            {g.pages.map((p) => (
              <a
                href={`/${lang}/handbook/${p.data.id}/`}
                class:list={[{ active: p.data.id === page.id }]}
              >
                {p.data.title[lang]}
              </a>
            ))}
          </details>
        ))
      }
    </aside>

    <div class="doc-col">
      <details class="mobnav">
        <summary>
          {lang === 'fr' ? 'Sections du handbook' : 'Handbook sections'}
          <span class="chev">▾</span>
        </summary>
        <div class="mob-list">
          {
            grouped.map((g) => (
              <>
                <h5>{secLabel[g.section][lang]}</h5>
                {g.pages.map((p) => (
                  <a
                    href={`/${lang}/handbook/${p.data.id}/`}
                    class:list={[{ active: p.data.id === page.id }]}
                  >
                    {p.data.title[lang]}
                  </a>
                ))}
              </>
            ))
          }
        </div>
      </details>

      <h1 class="book-h1">{page.title[lang]}</h1>
      {/* feature-status promises "the page carries a dateModified so you can see when it was last
          reviewed" — and the date only existed in the JSON-LD, invisible to the reader it was
          promised to. A page whose argument is "we tell you when we reviewed it" must show it. */}
      {(page.dateModified ?? page.datePublished) && (
        <p class="hb-date">
          {lang === 'fr' ? 'Revu le ' : 'Last reviewed '}
          <time datetime={page.dateModified ?? page.datePublished}>
            {new Intl.DateTimeFormat(lang === 'fr' ? 'fr-FR' : 'en-GB', {
              year: 'numeric', month: 'long', day: 'numeric',
            }).format(new Date(page.dateModified ?? page.datePublished!))}
          </time>
        </p>
      )}
      {page.summary && <p class="book-lede" set:html={ledeHtml} />}

      <div class="prose" set:html={bodyHtml} />

      {
        page.cite && page.cite.length > 0 && (
          <div class="deepen">
            <span class="dk">{lang === 'fr' ? 'Pour aller plus loin' : 'Go deeper'}</span>
            {page.cite.map((c) => (
              <a href={c.url} target="_blank" rel="noopener noreferrer">
                {typeof c.label === 'string' ? c.label : c.label[lang]} ↗
              </a>
            ))}
          </div>
        )
      }

      {
        relatedRules.length > 0 && (
          <section class="related">
            <h2>{lang === 'fr' ? 'Règles Pavois' : 'Pavois rules'} ({relatedRules.length})</h2>
            <div class="rule-pills">
              {relatedRules.map((r) => (
                <a class="rule-pill" href={`/${lang}/rules/${r.data.id}/`}>
                  {r.data.title[lang]}
                </a>
              ))}
            </div>
          </section>
        )
      }
    </div>
    <Toc headings={headings} lang={lang} />
  </div>
</Base>
