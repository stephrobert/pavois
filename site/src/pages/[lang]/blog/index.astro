---
import { getCollection } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { languages, type Lang } from '../../../i18n/ui';
import { categoryLabel, formatDate, readingTimeMinutes } from '../../../lib/blog';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params as { lang: Lang };
const posts = (await getCollection('blog'))
  .filter((p) => p.data.lang === lang && !p.data.draft)
  .sort((a, b) => (a.data.datePublished < b.data.datePublished ? 1 : -1));

const title = lang === 'fr' ? 'Blog · Pavois' : 'Blog · Pavois';
const intro =
  lang === 'fr'
    ? 'Notes de version, méthodologie et retours de terrain sur le durcissement Linux effectif, la conformité multi-normes et le verdict reboot-proof de Pavois.'
    : 'Release notes, methodology and field notes on effective Linux hardening, multi-standard compliance and the reboot-proof verdict behind Pavois.';

const crumbs = [
  { name: 'Pavois', path: `/${lang}/` },
  { name: 'Blog', path: `/${lang}/blog/` },
];
const slugOf = (id: string) => id.replace(/^(en|fr)\//, '');
---

<Base title={title} description={intro} lang={lang} schema="CollectionPage" breadcrumbs={crumbs}>
  <section class="wrap blog-list">
    <header class="blog-head">
      <span class="eyebrow">Blog</span>
      <h1>{lang === 'fr' ? 'Le blog Pavois' : 'The Pavois blog'}</h1>
      <p class="blog-intro">{intro}</p>
    </header>

    {posts.length === 0 ? (
      <p class="muted">{lang === 'fr' ? 'Bientôt des articles.' : 'Posts coming soon.'}</p>
    ) : (
      <ul class="post-grid">
        {posts.map((p) => (
          <li class="post-card">
            <a href={`/${lang}/blog/${slugOf(p.id)}/`}>
              <span class="pc-cat">{categoryLabel(p.data.category, lang)}</span>
              <h2>{p.data.title}</h2>
              <p class="pc-desc">{p.data.description}</p>
              <p class="pc-meta">
                {formatDate(p.data.dateModified ?? p.data.datePublished, lang)} · {readingTimeMinutes(p.body)} {lang === 'fr' ? 'min' : 'min'}
              </p>
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Base>

<style>
  .blog-list {
    padding-top: 40px;
    padding-bottom: 60px;
  }
  .blog-head {
    max-width: 720px;
    margin-bottom: 34px;
  }
  .blog-head h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    margin: 8px 0 12px;
  }
  .blog-intro {
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--color-dim);
  }
  .post-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 18px;
  }
  .post-card a {
    display: block;
    height: 100%;
    padding: 20px;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    background: var(--color-surface);
    transition: border-color 0.15s, transform 0.15s;
  }
  .post-card a:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }
  .pc-cat {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--color-accent);
  }
  .post-card h2 {
    font-size: 1.18rem;
    line-height: 1.25;
    margin: 8px 0 10px;
  }
  .pc-desc {
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-dim);
    margin: 0 0 14px;
  }
  .pc-meta {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--color-faint);
    margin: 0;
  }
</style>
