---
import Base from '../layouts/Base.astro';
---

<Base title="404 · Pavois" description="Page not found." lang="en" noindex={true}>
  <section class="wrap nf">
    <p class="nf-code">404</p>
    <h1>Page not found</h1>
    <p class="nf-lede">
      This page does not exist or has moved. Page introuvable ou déplacée.
    </p>
    <div class="nf-links">
      <a class="btn" href="/en/">Home</a>
      <a class="btn" href="/en/rules/">Browse controls</a>
      <a class="btn" href="/en/handbook/">Handbook</a>
      <a class="btn" href="/fr/">Accueil (FR)</a>
    </div>
  </section>
</Base>

<style>
  .nf {
    max-width: 640px;
    padding: 80px 0 100px;
    text-align: center;
  }
  .nf-code {
    font-family: var(--font-mono);
    font-size: 4rem;
    font-weight: 700;
    color: var(--color-accent);
    margin: 0;
    line-height: 1;
  }
  .nf h1 {
    margin: 8px 0 14px;
  }
  .nf-lede {
    color: var(--color-dim);
    margin-bottom: 28px;
  }
  .nf-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }
  .nf-links .btn {
    padding: 9px 16px;
    border: 1px solid var(--color-border);
    border-radius: 9px;
    font-family: var(--font-mono);
    font-size: 0.84rem;
    color: var(--color-text);
  }
  .nf-links .btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
</style>
