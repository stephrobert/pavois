# Example configuration for tools/clean_room_campaign.sh — COPY to `campaign.env` (gitignored) and
# fill in YOUR lab. Nothing here is real: the IPs are TEST-NET-3 (RFC 5737) placeholders, and the
# password must be your own. Never commit the filled-in copy.

# ssh target of your Proxmox host
export PVE=root@203.0.113.11
# directory on the Proxmox host holding the vendor cloud images
export ISO=/var/lib/vz/template/iso
# gateway + allowed source CIDR of the VM subnet
export CK_GW=203.0.113.1
export PAVOIS_SSH_FROM=203.0.113.0/24
# sudo password of the CK_USER (default pavois) account on the freshly-provisioned VMs
export PAVOIS_SUDO_PASSWORD=change-me
# VMIDs this script is ALLOWED to stop/destroy. Pick a range that is YOURS and collides with
# nothing else on the hypervisor: the script destroys these, and only re-checks the name as a
# second guard. A typo here costs a machine.
export PAVOIS_VMIDS="201 202 203 204 205 206"
# the fleet: one `os:vmid:ip:image` row per line (comments and blank lines ignored)
export FLEET_FILE=tools/clean_room_fleet.example
